/Manifest*.toml
/LocalPreferences.toml

# Only runtests.jl (the real, maintained test suite) is tracked under test/.
# Everything else -- cluster-only tooling, exploratory/one-off scripts,
# generated figures/videos/data -- is ignored wholesale so new files never
# need a new .gitignore line.
/test/*
!/test/runtests.jl

# OS junk
.DS_Store
Thumbs.db

# Julia build/test artifacts
*.jl.cov
*.jl.*.cov
*.jl.mem
/docs/build/

# Literate.jl output: regenerated from docs/src/examples/*.jl by docs/make.jl on every build.
/docs/src/examples/*.md
